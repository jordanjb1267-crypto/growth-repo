# Autonomous Organic Growth OS — environment template
#
# Copy to .env and fill in. NEVER commit .env.
# The audit script reports only whether a key is PRESENT, never its value.

# ---------------------------------------------------------------------------
# Kill switches — ALL FAIL CLOSED.
# An unset or malformed value is read as false. Only the exact string "true"
# enables publishing. Deleting a line disables that channel; it does not
# fall back to enabled.
# ---------------------------------------------------------------------------
AUTOPUBLISH_ENABLED=false
YOUTUBE_AUTOPUBLISH_ENABLED=false
TIKTOK_AUTOPUBLISH_ENABLED=false
INSTAGRAM_AUTOPUBLISH_ENABLED=false
FACEBOOK_AUTOPUBLISH_ENABLED=false
LINKEDIN_AUTOPUBLISH_ENABLED=false
EMAIL_AUTOSEND_ENABLED=false
BLOG_AUTOPUBLISH_ENABLED=false

# ---------------------------------------------------------------------------
# Content generation backend
# "claude-cli" shells out to non-interactive Claude Code (subscription-based,
# no metered token cost). "anthropic-api" is stubbed and not yet wired.
# ---------------------------------------------------------------------------
# Approval requests older than this expire out of the queue (digest sweep)
APPROVAL_EXPIRY_HOURS=168

# Whether the SCHEDULER emails you the daily approval digest. This is a
# founder-notification control, deliberately separate from the marketing kill
# switches above — those govern publishing to an audience, this governs mail to
# you. Left false so that inserting Resend credentials does not silently start
# sending on a schedule. Only the exact string "true" enables it.
# The manual path (`npm run approval:digest -- --email`) is unaffected.
SCHEDULER_DIGEST_EMAIL=false

LLM_PROVIDER=claude-cli
LLM_MODEL_GENERATION=claude-opus-5
LLM_MODEL_CLASSIFICATION=claude-opus-5
# Only needed if LLM_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Social publishing — Blotato (the default backend)
#
# Founder directive (CLAUDE.md addendum A9): social posting runs through
# Blotato instead of per-platform credentials. Standup:
#
#   1. Create a Blotato API key (dashboard → Settings → API) → BLOTATO_API_KEY
#   2. Connect each social account once in the Blotato dashboard
#   3. npm run blotato:accounts  → copy the account IDs below
#
# The same Blotato workspace powers the Blotato MCP connector, so the queue
# can also be inspected and controlled conversationally from Claude.
# Kill switches above still gate every platform — Blotato changes how a post
# is delivered, not whether it is allowed to go out.
# ---------------------------------------------------------------------------
PUBLISH_BACKEND=blotato
BLOTATO_API_KEY=
BLOTATO_LINKEDIN_ACCOUNT_ID=
BLOTATO_FACEBOOK_ACCOUNT_ID=
# Shown in the Blotato dashboard under the connected Facebook account
BLOTATO_FACEBOOK_PAGE_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
BLOTATO_YOUTUBE_ACCOUNT_ID=
BLOTATO_TIKTOK_ACCOUNT_ID=

# Via Blotato (audited platform apps) these can be public from day one.
# If you switch to PUBLISH_BACKEND=direct, set them back to private /
# SELF_ONLY until your own platform audits pass — unaudited direct API
# projects cannot make public posts regardless of this setting.
YOUTUBE_PRIVACY_STATUS=public
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Public base URL where the assets/ directory is hosted. Blotato ingests
# media by URL (as does Instagram's own API), so all video publishing needs
# this (e.g. https://assets.example.com). npm run site:build mirrors assets/
# into site/dist for any static host.
ASSET_BASE_URL=

# ---------------------------------------------------------------------------
# Direct platform credentials — ONLY used when PUBLISH_BACKEND=direct.
# Filled by the auth bootstrap scripts, not by hand:
#
#   npm run auth:linkedin   needs LINKEDIN_CLIENT_ID/SECRET set first;
#                           localhost redirect on port 8976
#   npm run auth:meta       needs META_APP_ID/SECRET set first; run with a
#                           short-lived Graph Explorer user token as argument
#   npm run auth:youtube    needs YOUTUBE_CLIENT_ID/SECRET set first; OAuth
#                           client type must be "TVs and Limited Input devices"
#   npm run auth:tiktok     needs TIKTOK_CLIENT_KEY/SECRET/REDIRECT_URI set
#                           first; paste-code flow
#
# Direct-path reach reality (see /audit/CONNECTOR_AUDIT.md): YouTube uploads
# are PRIVATE and TikTok posts are SELF_ONLY until each platform's audit
# passes. This is the main reason Blotato is the default.
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

META_APP_ID=
META_APP_SECRET=
# Only needed if the token user administers more than one Page
META_PAGE_NAME=
META_GRAPH_VERSION=v23.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202506
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_URN=

# ---------------------------------------------------------------------------
# Owned channels
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM_ADDRESS=
# Where the daily approval digest email goes (approval-digest --email)
FOUNDER_EMAIL=
BLOG_DEPLOY_HOOK_URL=

# Product landing pages. Published CTA links get UTM parameters appended
# (utm_campaign carries the content ID), which is how PostHog funnel events
# map back to the originating content item.
RIG_RECEIPTS_URL=
TILAWAH_LOCK_URL=

# ---------------------------------------------------------------------------
# Analytics
# POSTHOG_PROJECT_API_KEY is the ingestion key (for the product/landing pages).
# Querying funnel metrics needs a PERSONAL API key — the ingestion key cannot
# read data. One personal key covers both projects.
#
# Each product has its own PostHog project (separate organisations), so each
# gets its own project ID. A product whose ID is unset is reported as having
# NO funnel data rather than zero — an absent number and a real zero mean very
# different things to the learning rules. POSTHOG_PROJECT_ID (below) is a
# single-project fallback used only when the per-product key is unset.
# ---------------------------------------------------------------------------
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID_RIG_RECEIPTS=518659
POSTHOG_PROJECT_ID_TILAWAH_LOCK=538185
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
