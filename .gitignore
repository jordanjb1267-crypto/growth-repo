# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local-only content and logs (machine-specific, not shared state)
logs/*.jsonl
content/**/*.local.json
analytics/raw/**

# OS noise
.DS_Store
Thumbs.db

# Assets are large binaries — track deliberately, not by accident
assets/**/*.mp4
assets/**/*.mov
assets/**/*.png
assets/**/*.jpg
assets/**/*.jpeg
logs/*.json
logs/*.log
site/dist/
